# Environment variables for ai-ran-kpi-forecasting
# Copy to .env and fill in values. Never commit .env.

# Default output directory for forecast artifacts
# FORECAST_OUTPUT_DIR=reports/forecast_examples/latest

# Default cell ID for sample runs
# FORECAST_CELL_ID=CELL_001

# Default KPI column
# FORECAST_KPI_COL=prb_dl_util

# Optional: path to operator-provided telemetry CSV (overrides sample data)
# FORECAST_DATA_PATH=data/ran_kpi_sample.csv

# Optional: random state for reproducibility
# FORECAST_RANDOM_STATE=42
